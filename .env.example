# ==============================================================================
# EARTH EVENT & DISASTER MONITORING SYSTEM (earth-emds) — ENVIRONMENT CONFIG
# ==============================================================================
# Copy or edit `.env` directly.
# Out of the 5 data/map sources, 4 are 100% FREE with NO API KEY required:
#   1. NASA EONET v3 API          -> Free, no key required
#   2. REST Countries v3.1 API    -> Free, no key required
#   3. Natural Earth Admin 0      -> Free public-domain dataset, no key required
#   4. CesiumJS Open Basemaps     -> Free (Esri World Imagery / CARTO / OSM), no key required
#
# ONLY 1 FREE API KEY IS NEEDED FOR LIVE NEWSAPI QUERIES:
#   5. NewsAPI v2 (Free Developer Plan: 100 requests/day)
#      How to get it in 30 seconds:
#        a) Go to https://newsapi.org/register
#        b) Enter your name, email, and select "Individual / Academic"
#        c) Copy your 32-character API key and paste it below in NEWSAPI_KEY
# ==============================================================================

# --- 1. NewsAPI v2 (Paste your free key from https://newsapi.org/register) ---
NEWSAPI_KEY=PASTE_YOUR_FREE_NEWSAPI_KEY_HERE
NEWSAPI_BASE_URL=https://newsapi.org/v2
NEWSAPI_DAILY_BUDGET=90

# --- 2. Free Keyless Upstream APIs (No changes needed) ---
EONET_BASE_URL=https://eonet.gsfc.nasa.gov/api/v3
EONET_POLL_INTERVAL_SECONDS=600
EONET_CLOSED_LIMIT=100

REST_COUNTRIES_BASE_URL=https://restcountries.com/v3.1

# --- 3. Optional Cesium Ion Token (Leave blank to use 100% free keyless tiles) ---
# Only fill this if you want Cesium World Terrain 3D meshes from https://ion.cesium.com/tokens
VITE_CESIUM_ION_TOKEN=

# --- 4. PostgreSQL + PostGIS Database (Docker Internal Network) ---
POSTGRES_USER=earthemds
POSTGRES_PASSWORD=earthemds_local_dev_password
POSTGRES_DB=earthemds
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://earthemds:earthemds_local_dev_password@db:5432/earthemds

# --- 5. Redis Cache & Rate-Limit Store (Docker Internal Network) ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0
CACHE_TTL_SECONDS=300

# --- 6. Application & Security Settings ---
ENVIRONMENT=development
FRONTEND_ORIGIN=http://localhost:3000
VITE_API_BASE_URL=http://localhost:8000/api/v1
RATE_LIMIT_PER_MINUTE=120
