#!/usr/bin/env sh
# ==============================================================================
# Git Pre-Commit Guardrail: Blocks Bulk Commits & Secret Leaks
# ==============================================================================

STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACMR)
if [ -z "$STAGED_FILES" ]; then
  exit 0
fi

FILE_COUNT=$(echo "$STAGED_FILES" | wc -l | tr -d ' ')
MAX_FILES=${MAX_COMMIT_FILES:-8}

# 1. Block .env files
if echo "$STAGED_FILES" | grep -E '(^|/)\.env(\..+)?$' | grep -v '\.env\.example$' >/dev/null 2>&1; then
  echo "[GUARDRAIL BLOCKED] Refusing to commit .env file! Only .env.example is allowed."
  exit 1
fi

# 2. Block Bulk Commits (> MAX_FILES staged at once)
if [ "$FILE_COUNT" -gt "$MAX_FILES" ]; then
  echo "[GUARDRAIL BLOCKED] Bulk commit detected ($FILE_COUNT files staged; max allowed is $MAX_FILES)."
  echo "Stage and commit files atomically per feature/module instead of committing in bulk."
  exit 1
fi

# 3. Block mixing frontend/ and backend/ code in a single commit
HAS_FRONTEND=$(echo "$STAGED_FILES" | grep '^frontend/' || true)
HAS_BACKEND=$(echo "$STAGED_FILES" | grep '^backend/' || true)
if [ -n "$HAS_FRONTEND" ] && [ -n "$HAS_BACKEND" ]; then
  echo "[GUARDRAIL BLOCKED] Cross-stack bulk commit detected (both frontend/ and backend/ staged)."
  echo "Commit backend/ and frontend/ changes in separate atomic commits."
  exit 1
fi

exit 0
